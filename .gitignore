# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.local.example

# vercel
.vercel

# generated by scripts/copy-pdf-worker.mjs (postinstall)
/public/pdf.worker.min.mjs

# generated by scripts/copy-maplibre-worker.mjs (postinstall)
/public/maplibre-gl-worker.mjs
/public/maplibre-gl-shared.mjs

# typescript
*.tsbuildinfo
next-env.d.ts

# Task-local analysis, checks and intermediate exports
/work/

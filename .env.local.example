# Supabase project settings (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# No Mapbox key needed — maps run on OpenFreeMap (streets) + Esri World
# Imagery (satellite), both free/keyless. See lib/mapStyles.ts.

# SSLCommerz (Merchant Panel > Integration for sandbox store_id/password)
# Currently unused — bKash is the active gateway (see below). Kept configured
# for an easy switch back later.
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_IS_SANDBOX=true

# bKash Tokenized Checkout (bKash Merchant Portal > Developer > App credentials)
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
BKASH_IS_SANDBOX=true

# Placeholder — set the real one-time lifetime price (BDT) before launch
LIFETIME_PRICE_BDT=2000

# Sentry (sentry.io project settings). Error tracking is wired up (instrumentation.ts,
# instrumentation-client.ts, app/error.tsx, app/global-error.tsx) but inert without a DSN —
# TODO: fill these in once a Sentry project exists.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=

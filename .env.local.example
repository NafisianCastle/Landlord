# Supabase project settings (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Canonical production domain — used for sitemap/robots/canonical/OG tags.
# Defaults to the Vercel production domain or www.landlordsbd.com.
# Set this explicitly when using a custom domain.
NEXT_PUBLIC_SITE_URL=https://www.landlordsbd.com

# No Mapbox key needed — maps run on OpenFreeMap (streets) + Esri World
# Imagery (satellite), both free/keyless. See lib/mapStyles.ts.

# SSLCommerz (Merchant Panel > Integration for sandbox store_id/password)
# Currently unused — bKash is the active gateway (see below). Kept configured
# for an easy switch back later.
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_IS_SANDBOX=true

# bKash Tokenized Checkout (bKash Merchant Portal > Developer > App credentials)
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
BKASH_IS_SANDBOX=true

# Placeholder — set the real one-time lifetime price (BDT) before launch
LIFETIME_PRICE_BDT=2000

# Web push (rent-due reminders). Generate a stable pair and cron secret with:
# npm run setup:push -- --subject mailto:your-real-contact@example.com
# See docs/push-notifications.md. The public key is provided by the server at runtime.
VAPID_PUBLIC_KEY=
# Legacy fallback only (not needed when VAPID_PUBLIC_KEY is set).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Shared secret the cron request must send as `Authorization: Bearer <value>`
# so only Vercel Cron (not the public) can trigger the reminder endpoint.
# Generate with `openssl rand -hex 32`.
CRON_SECRET=

# Sentry (sentry.io project settings). Error tracking is wired up (instrumentation.ts,
# instrumentation-client.ts, app/error.tsx, app/global-error.tsx) but inert without a DSN —
# TODO: fill these in once a Sentry project exists.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=

# Demo account ("Try the demo" button on /login, signs straight into a
# pre-seeded dashboard). Run `npm run seed:demo` after setting these to
# create/reset the account and its sample data. Set
# NEXT_PUBLIC_DEMO_LOGIN_ENABLED=true to show the button.
NEXT_PUBLIC_DEMO_LOGIN_ENABLED=false
DEMO_USER_EMAIL=demo@landly.app
DEMO_USER_PASSWORD=
